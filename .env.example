# Verifier model — any LiteLLM-style provider/model string supported by Vercel AI SDK.
# Default below. Override examples:
#   VOUCH_VERIFIER_MODEL=vertex_ai/gemini-3.1-pro-preview
#   VOUCH_VERIFIER_MODEL=openai/gpt-4o
#   VOUCH_VERIFIER_MODEL=anthropic/claude-sonnet-4-6
VOUCH_VERIFIER_MODEL=vertex_ai/gemini-3.1-pro-preview

# Embedder model — same convention.
#   VOUCH_EMBEDDER_MODEL=vertex_ai/text-embedding-005
#   VOUCH_EMBEDDER_MODEL=openai/text-embedding-3-small
VOUCH_EMBEDDER_MODEL=vertex_ai/text-embedding-005

# Vertex auth — service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# OpenAI (only if using openai/* provider)
# OPENAI_API_KEY=sk-...

# Anthropic (only if using anthropic/* provider)
# ANTHROPIC_API_KEY=sk-ant-...

# DB path (default ~/.vouch/store.db)
# VOUCH_DB_PATH=

# Verification confidence threshold for "supported" (default 0.6)
# VOUCH_SUPPORT_THRESHOLD=0.6

# `vouch gate` extractor model (default below). Use a fast, cheap model.
# VOUCH_GATE_MODEL=vertex_ai/gemini-3.1-flash-lite

# `vouch gate` workspace projects — comma-separated names of projects you
# author / maintain / dogfood. The extractor treats claims about their
# command surface, flags, paths, tests, build state, etc. as workspace
# context and skips them. Optional; the generic principle handles common
# cases without it. Set when the generic principle misses your project.
# VOUCH_GATE_WORKSPACE_PROJECTS=my-cli,my-lib,my-vault
