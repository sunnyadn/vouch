# Verifier model — any LiteLLM-style provider/model string supported by Vercel AI SDK.
# Default below. Override examples:
#   VOUCH_VERIFIER_MODEL=vertex_ai/gemini-3.1-pro-preview
#   VOUCH_VERIFIER_MODEL=openai/gpt-4o
#   VOUCH_VERIFIER_MODEL=anthropic/claude-sonnet-4-6
VOUCH_VERIFIER_MODEL=vertex_ai/gemini-3.1-pro-preview

# Embedder model — same convention.
#   VOUCH_EMBEDDER_MODEL=vertex_ai/text-embedding-005
#   VOUCH_EMBEDDER_MODEL=openai/text-embedding-3-small
VOUCH_EMBEDDER_MODEL=vertex_ai/text-embedding-005

# Vertex auth — GOOGLE_APPLICATION_CREDENTIALS or `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# OpenAI (only if using openai/* provider)
# OPENAI_API_KEY=sk-...

# Anthropic (only if using anthropic/* provider)
# ANTHROPIC_API_KEY=sk-ant-...

# DB path (default ~/.vouch/store.db)
# VOUCH_DB_PATH=

# Verification confidence threshold for "supported" (default 0.6)
# VOUCH_SUPPORT_THRESHOLD=0.6
