# vouch's LLM reviewer needs an Anthropic-compatible endpoint + API key.
# IMPORTANT: a Claude Code subscription / OAuth login does NOT export a key —
# without one the reviewer silently no-ops and only the deterministic gate runs.
# Run `vouch doctor` to verify the round-trip actually works.

ANTHROPIC_API_KEY=

# Endpoint — defaults to api.anthropic.com. Point at a compatible gateway:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic   # DeepSeek (pay-per-token, no hard quota)
#   ANTHROPIC_BASE_URL=https://api.kimi.com/coding/         # Moonshot / kimi
# ANTHROPIC_BASE_URL=

# Reviewer model (as named on your gateway, e.g. deepseek-v4-pro, kimi-k2.6).
# VOUCH_REVIEWER_MODEL=deepseek-v4-pro

# Skip the LLM reviewer deliberately (the deterministic commit gate still runs):
# VOUCH_REVIEWER_OFF=1

# Where the verdict corpus is logged (default ~/.claude/vouch-corpus.jsonl):
# VOUCH_CORPUS_PATH=
